{
  "info": {
    "name": "FinanzasAR",
    "description": "Colección para FinanzasAR. El login guarda el accessToken en una variable de colección automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manueljmpereira93@gmail.com\",\n  \"password\": \"TuPassword123!\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "  console.log('Token guardado en {{accessToken}}');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manueljmpereira93@gmail.com\",\n  \"password\": \"TuPassword123!\"\n}"
            }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Incomes",
      "item": [
        {
          "name": "Listar ingresos (mes/año opcional)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "url": {
              "raw": "{{baseUrl}}/incomes?year=2026&month=6",
              "host": ["{{baseUrl}}"],
              "path": ["incomes"],
              "query": [
                { "key": "year", "value": "2026" },
                { "key": "month", "value": "6" }
              ]
            }
          }
        },
        {
          "name": "Resumen mensual",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "url": {
              "raw": "{{baseUrl}}/incomes/summary?year=2026&month=6",
              "host": ["{{baseUrl}}"],
              "path": ["incomes", "summary"],
              "query": [
                { "key": "year", "value": "2026" },
                { "key": "month", "value": "6" }
              ]
            }
          }
        },
        {
          "name": "Crear ingreso",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "url": { "raw": "{{baseUrl}}/incomes", "host": ["{{baseUrl}}"], "path": ["incomes"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1500.00,\n  \"currency\": \"USD\",\n  \"date\": \"2026-06-05\",\n  \"description\": \"Factura cliente exterior\",\n  \"entityId\": null\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Entities",
      "item": [
        {
          "name": "Listar entidades",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "url": { "raw": "{{baseUrl}}/entities", "host": ["{{baseUrl}}"], "path": ["entities"] }
          }
        },
        {
          "name": "Crear entidad",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "url": { "raw": "{{baseUrl}}/entities", "host": ["{{baseUrl}}"], "path": ["entities"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Banco Galicia\",\n  \"type\": \"Bank\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Monotributo",
      "item": [
        {
          "name": "Tabla de categorías",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "url": { "raw": "{{baseUrl}}/monotributo/categories", "host": ["{{baseUrl}}"], "path": ["monotributo", "categories"] }
          }
        },
        {
          "name": "Estado actual",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "url": {
              "raw": "{{baseUrl}}/monotributo/status?year=2026",
              "host": ["{{baseUrl}}"],
              "path": ["monotributo", "status"],
              "query": [{ "key": "year", "value": "2026" }]
            }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Descargar PDF mensual",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "url": {
              "raw": "{{baseUrl}}/reports/monthly?year=2026&month=6",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "monthly"],
              "query": [
                { "key": "year", "value": "2026" },
                { "key": "month", "value": "6" }
              ]
            }
          }
        }
      ]
    }
  ]
}
